"""
================================================================================
ARGO ENVIRONMENT CONFIGURATION (.env.example)
================================================================================

Copy this file to .env and customize for your environment.

All values are optional. Defaults are provided for each setting.

================================================================================
LATENCY CONFIGURATION
================================================================================
"""

# Latency profile for performance tuning
# Options: FAST, ARGO, ROBUST
# Default: ARGO
ARGO_LATENCY_PROFILE=ARGO

# Enable latency profiling and reporting
# Options: true, false
# Default: false
ARGO_LATENCY_PROFILING=false

# ============================================================================
# AUDIO OUTPUT CONFIGURATION (Phase 7A-0)
# ============================================================================

# Enable audio output entirely
# If false, output is text-only
# Options: true, false
# Default: false
VOICE_ENABLED=false

# Enable Piper TTS specifically
# Requires VOICE_ENABLED=true
# Options: true, false
# Default: false
PIPER_ENABLED=false

# Voice profile selection (Phase 7D)
# Determines which voice model to use when PIPER_ENABLED=true
# No behavior changes - sound/identity only
# Can only switch when system is idle (not SPEAKING/THINKING/LISTENING with active audio)
# Options:
#   - lessac (default): American male voice (en_US-lessac-medium.onnx)
#   - allen: British male voice (en_GB-alan-medium.onnx)
# Default: lessac
# Note: Switching voices requires system restart or idle state
VOICE_PROFILE=lessac

# Path to Piper binary (Windows x64 v1.2.0)
# Must be relative to repo root or absolute path
# Default: audio/piper/piper.exe
PIPER_PATH=audio/piper/piper.exe

# Path to voice model ONNX file
# This is set automatically based on VOICE_PROFILE above
# Do not change unless using custom voice models
# Available voices:
#   - en_US-lessac-medium.onnx (American male) - RECOMMENDED
#   - en_US-amy-medium.onnx (American female)
#   - en_GB-alan-medium.onnx (British male) - RECOMMENDED
# Default: audio/piper/voices/en_US-lessac-medium.onnx
PIPER_VOICE=audio/piper/voices/en_US-lessac-medium.onnx

# Enable timing probes for Piper audio operations
# Logs: audio_request_start, audio_first_output
# Options: true, false
# Default: false
PIPER_PROFILING=false

# ============================================================================
# STATE MACHINE CONFIGURATION (Phase 7B)
# ============================================================================

# Enable wake word detection ("ARGO")
# Transitions from SLEEP to LISTENING
# Options: true, false
# Default: true
WAKE_WORD_ENABLED=true

# Enable sleep word detection ("go to sleep")
# Transitions from any state to SLEEP
# Options: true, false
# Default: true
SLEEP_WORD_ENABLED=true

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama server host
# Default: localhost
OLLAMA_HOST=localhost

# Ollama server port
# Default: 11434
OLLAMA_PORT=11434

# Ollama model name
# Default: argo (local Modelfile)
OLLAMA_MODEL=argo

# ============================================================================
# MEMORY BACKEND
# ============================================================================

# Durable memory backend.
# Options: sqlite, postgres
# Default: sqlite
ARGO_MEMORY_BACKEND=sqlite

# SQLite memory path when ARGO_MEMORY_BACKEND=sqlite
# Default: data/memory.db
ARGO_MEMORY_SQLITE_PATH=data/memory.db

# PostgreSQL DSN when ARGO_MEMORY_BACKEND=postgres
# Example: postgresql://argo:argo@localhost:5432/argo
# Keep real credentials in .env only.
ARGO_POSTGRES_DSN=

# ============================================================================
# LIVEKIT REALTIME VOICE / AVATAR
# ============================================================================

# Local default values match scripts/start_livekit_realtime.ps1.
ARGO_LIVEKIT_ENABLED=true
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecretdevsecret
ARGO_LIVEKIT_ROOM=argo-live
ARGO_REALTIME_MODEL=gpt-realtime
ARGO_REALTIME_VOICE=marin

# Optional Hedra avatar video path.
# Requires a real Hedra API key and either an uploaded avatar ID or local image.
# ARGO pins livekit-plugins-hedra==1.4.6 for this legacy path.
ARGO_HEDRA_AVATAR_ENABLED=false
HEDRA_API_KEY=
HEDRA_AVATAR_ID=
HEDRA_AVATAR_IMAGE=
HEDRA_AVATAR_PARTICIPANT_IDENTITY=argo-hedra-avatar
HEDRA_AVATAR_PARTICIPANT_NAME=argo-hedra-avatar

# ============================================================================
# DEBUG & TESTING
# ============================================================================

# Enable debug output
# Options: true, false
# Default: false
DEBUG=false

# Suppress interactive prompts (for testing/CI)
# Options: true, false
# Default: false
NO_INTERACTIVE=false
